{
  "name": "@alexdiliberto/eslint-config",
  "version": "9.0.1",
  "description": "Alex DiLiberto's preferred ESLint rules",
  "keywords": [
    "eslint",
    "eslint-config",
    "eslintconfig"
  ],
  "homepage": "https://github.com/alexdiliberto/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/alexdiliberto/eslint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexdiliberto/eslint-config.git"
  },
  "license": "MIT",
  "author": "Alex DiLiberto <npm@alexdiliberto.com>",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": "./flat.js",
    "./flat": "./flat.js"
  },
  "main": "flat.js",
  "files": [
    "flat.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "pnpm lint && pnpm test",
    "clean": "rm -rf node_modules",
    "lint": "eslint . --max-warnings=0",
    "prepare": "husky",
    "release": "release-it",
    "test": "pnpm test:unit",
    "test:fix": "node -e \"console.log('run full test suite; fix assertions are included')\"",
    "test:unit": "tape test/*.js"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@release-it/conventional-changelog": "^12.0.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "release-it": "^21.1.1",
    "tape": "^5.10.2"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "packageManager": "pnpm@11.28.3",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "volta": {
    "node": "24.15.0",
    "pnpm": "11.28.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
